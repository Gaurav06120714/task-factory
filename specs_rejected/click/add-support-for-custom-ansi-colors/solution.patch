+def custom_color(color_code: str) -> str:
+    """Convert a custom ANSI color code to a valid ANSI escape sequence.
+
+    :param color_code: A string representing the custom color code.
+    :return: A string representing the valid ANSI escape sequence.
+    """
+    if not color_code.isdigit():
+        raise ValueError(f"Invalid color code: {color_code}")
